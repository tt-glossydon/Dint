; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dint"
run/main_scene="uid://bdp7my57prhol"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://bei4yc1qe05va"

[audio]

buses/default_bus_layout="uid://b8wr0hwoqop4v"

[autoload]

Gamemanager="*uid://by58xlf3u8puo"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/initial_position_type=4
window/size/sharp_corners=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godotsteam/plugin.cfg")

