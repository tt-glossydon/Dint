[sub_resource type="GDScript" id="GDScript_0lb7f"]
script/source = "extends Node3D

@export var spring: SpringFollower3D

func _ready() -> void:
	refresh()
	
func refresh():
	var timer := get_tree().create_timer(randf_range(1, 3))
	spring.target = get_children().pick_random()
	timer.timeout.connect(refresh)
"

