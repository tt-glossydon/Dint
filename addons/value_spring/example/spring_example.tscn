[sub_resource type="GDScript" id="GDScript_nux04"]
script/source = "extends MeshInstance3D

@export var spring: ValueSpring

var target_color: Color = Color.WHITE

func _ready() -> void:
	spring.reset_spring(target_color)
	refresh()
	
func refresh():
	var timer := get_tree().create_timer(randf_range(1, 3))
	timer.timeout.connect(refresh)
	target_color = Color.from_ok_hsl(randf(), randf_range(0.5, 1.0), randf_range(0.5, 1), 1.0)
	
func _process(delta: float) -> void:
	get_active_material(0).albedo_color = spring.update(delta, target_color)
"

[sub_resource type="Resource" id="Resource_0lb7f"]
